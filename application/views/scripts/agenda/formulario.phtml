        $("#fk_tipoexame_id").change(function() {
            var valor = $(this).val();
            if (valor == '5') { // 5 = Retorno ao Trabalho
                 // Se ja tiver horario selecionado, verifica
                 verificarHorarioRetornoTrabalho();
            } else {
                 // Reseta validacao se mudar o tipo
                 resetarValidacaoHorario();
            }
            document.getElementById("fk_alocacao_id").disabled = false;
        });

        // Monitorar mudança no horário (caso o usuário troque a data/horário)
        // O campo horário é preenchido via ajax/seleção, então monitoramos mudanças nele se possível
        // Mas como ele é disabled e preenchido por seleção de data, a verificação deve ocorrer ao tentar salvar ou ao selecionar data
        
        $("#botao-salvar-padrao").click(function (e) {
            e.preventDefault();
            
            if (verificarHorarioRetornoTrabalho()) {
                 $("#formulario-padrao-salvar").submit();
            }
        });

    });

    function verificarHorarioRetornoTrabalho() {
        var tipoExame = $("#fk_tipoexame_id").val();
        var horario = $("#horario").val(); // formato HH:mm ou HH:mm:ss
        
        if (tipoExame == '5' && horario) {
            var partes = horario.split(':');
            var hora = parseInt(partes[0]);
            
            if (hora < 10) {
                 $("#modalRetornoTrabalho").modal('show');
                 $("#horario").css('background-color', '#ffcccc'); // Vermelho claro
                 $("#horario").css('border-color', 'red');
                 $("#botao-salvar-padrao").attr('disabled', 'disabled');
                 return false;
            }
        }
        
        // Se estiver tudo ok, reseta estilos
        resetarValidacaoHorario();
        return true;
    }

    function resetarValidacaoHorario() {
         $("#horario").css('background-color', '');
