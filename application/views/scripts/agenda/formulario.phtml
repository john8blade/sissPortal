    <script>
        var localAgendaSelecionadoElemento = null;
        var localAgendaSelecionadoId = null;

        function confirmarLocalAgenda(elemento, id) {
            localAgendaSelecionadoElemento = elemento;
            localAgendaSelecionadoId = id;
            
            var nome = elemento.getAttribute('data-nome');
            var endereco = elemento.getAttribute('data-endereco');
            var complemento = elemento.getAttribute('data-complemento') || '';

            document.getElementById('modalConfirmarLocalNome').innerText = nome;
            document.getElementById('modalConfirmarLocalEndereco').innerText = endereco;

            var elComplemento = document.getElementById('modalConfirmarLocalComplemento');
            elComplemento.innerText = complemento;
            elComplemento.style.display = complemento ? 'block' : 'none';

            // Aviso temporário de mudança de endereço da unidade de Ribeirão das Neves
            // (local_agenda_id = 2 em produção). Remover quando não for mais necessário.
            var avisoNeves = document.getElementById('modalConfirmarLocalAvisoNeves');
            avisoNeves.style.display = (parseInt(id, 10) === 2) ? 'block' : 'none';

            $('#modalConfirmarLocal').modal('show');
        }

        function aplicarLocalAgenda() {
            if (!localAgendaSelecionadoElemento || !localAgendaSelecionadoId) return;
            
            // Atualiza o input hidden
            document.getElementById('fk_local_agenda_id').value = localAgendaSelecionadoId;
            
            // Remove a classe active de todos os botões e reseta os ícones e cores
            var botoes = document.querySelectorAll('.btn-local-agenda');
            botoes.forEach(function(btn) {
                btn.classList.remove('active');
                var icone = btn.querySelector('.icone-check');
                icone.classList.remove('fa-check-circle');
                icone.classList.add('fa-circle-o');
                var texto = btn.querySelector('.list-group-item-text');
                texto.style.color = '';
            });
            
            // Adiciona a classe active no botão clicado e muda o ícone e cor
            localAgendaSelecionadoElemento.classList.add('active');
            var iconeClicado = localAgendaSelecionadoElemento.querySelector('.icone-check');
            iconeClicado.classList.remove('fa-circle-o');
            iconeClicado.classList.add('fa-check-circle');
            var textoClicado = localAgendaSelecionadoElemento.querySelector('.list-group-item-text');
            textoClicado.style.color = '#d0e9c6';
            
            $('#modalConfirmarLocal').modal('hide');
            
            // Carrega o calendário
            listarDiasAtendimento();
        }
    </script>

