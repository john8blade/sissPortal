.calendario-dia-vagas { margin: 2px 0; }
.calendario-dia-botoes { display: flex; flex-wrap: wrap; gap: 4px; justify-content: center; }
.calendario-dia-botoes .btn { flex: 1; min-width: 60px; padding: 4px 6px; font-size: 10px; }
