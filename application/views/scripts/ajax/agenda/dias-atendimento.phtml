<?php
$mes = $this->mes;
$ano = $this->ano;
$mesExtenso = $this->mesExtenso;
$vagas = $this->vagas;
$primeiroDia = (int) date('N', strtotime("{$ano}-{$mes}-01"));
$ultimoDia = count($vagas);
$mapaDias = [];
foreach ($vagas as $v) { $mapaDias[$v['dia']] = $v; }
$diasSemana = ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb'];
$celulasVaziasInicio = ($primeiroDia % 7);
?>

<div class="calendario-vagas" data-mes="<?php echo $mes ?>" data-ano="<?php echo $ano ?>">
    <div class="calendario-header">
        <button type="button" class="btn btn-default btn-sm btn-prev-mes" title="Mês anterior">
            <i class="fa fa-chevron-left"></i>
        </button>
        <span class="calendario-mes-ano"><?php echo $mesExtenso ?> <?php echo $ano ?></span>
        <button type="button" class="btn btn-default btn-sm btn-prox-mes" title="Próximo mês">
            <i class="fa fa-chevron-right"></i>
        </button>
    </div>

    <table class="table table-bordered table-condensed calendario-grid">
        <thead>
            <tr>
                <?php foreach ($diasSemana as $d): ?>
                <th class="text-center"><?php echo $d ?></th>
                <?php endforeach; ?>
            </tr>
        </thead>
        <tbody>
            <tr>
                <?php
                $col = 0;
                for ($i = 0; $i < $celulasVaziasInicio; $i++, $col++): ?>
                <td class="calendario-vazio"></td>
                <?php endfor;
                for ($dia = 1; $dia <= $ultimoDia; $dia++):
                    $v = $mapaDias[$dia];
                    $isWeekend = $v['dia_semana'] > 5;
                    $isPassado = $v['passado'];
                    $classe = 'calendario-dia';
                    if ($isWeekend) $classe .= ' calendario-fim-semana';
                    if ($isPassado) $classe .= ' calendario-passado';
                ?>
                <?php if ($col > 0 && $col % 7 === 0): ?></tr><tr><?php endif; ?>
                <td class="<?php echo $classe ?>">
                    <div class="calendario-dia-num"><?php echo $dia ?></div>
                    <?php if (!$isWeekend): ?>
                    <div class="calendario-dia-vagas">
                        <small><?php echo ($v['vagas_manha'] + $v['vagas_tarde']) ?> vagas</small>
                    </div>
                    <div class="calendario-dia-botoes">
                        <?php if ($v['vagas_manha'] > 0 && !$isPassado): ?>
                        <button type="button" class="btn btn-default btn-xs bt-agendar-manha" data="<?php echo $v['data'] ?>">Agendar manhã</button>
                        <?php endif; ?>
                        <?php if ($v['vagas_tarde'] > 0 && !$isPassado): ?>
                        <button type="button" class="btn btn-default btn-xs bt-agendar-tarde" data="<?php echo $v['data'] ?>">Agendar tarde</button>
                        <?php endif; ?>
                    </div>
                    <?php else: ?>
                    <div class="calendario-dia-vagas"><small>—</small></div>
                    <?php endif; ?>
                </td>
                <?php $col++; endfor;
                while ($col % 7 !== 0): ?>
                <td class="calendario-vazio"></td>
                <?php $col++; endwhile; ?>
            </tr>
        </tbody>
    </table>
</div>

