$htmlRodape = obterHtmlDoRodapeEmPdf();

if (!empty($this->agenda['local_agenda_id'])) {
    $enderecoLocal = array_filter([
        $this->agenda['local_agenda_logradouro'], 
        $this->agenda['local_agenda_numero'], 
        $this->agenda['local_agenda_bairro'], 
        $this->agenda['local_agenda_cidade'] . ($this->agenda['local_agenda_uf'] ? '-' . $this->agenda['local_agenda_uf'] : '')
    ]);
    $enderecoCompleto = implode(', ', $enderecoLocal);
    
    // Substitui o endereço padrão da HTMED mantendo apenas o telefone
    $htmlRodape = preg_replace(
        '/HTMED[^\|]+\|/', 
        '<strong>Local de Atendimento:</strong> ' . $this->agenda['local_agenda_nome'] . ' - ' . $enderecoCompleto . ' |', 
        $htmlRodape
    );
}

$htmlCabecalho = file_get_contents($localScripts . 'guia-exames/' . 'cabecalho.html');

if (!is_null($this->agenda['horario_global_de'])) {

    $h2 = explode(':', $this->agenda['horario_global_ate']);
    $h1 = explode(':', $this->agenda['horario_global_de']);
    $horario = "{$h1[0]}:{$h1[1]} ~ {$h2[0]}:{$h2[1]}";

} else { $horario = "---"; }

$p = new mPDF('utf-8', 'A4', 0, '', 10, 10, 35, 30, 8, 8);
$p->SetHTMLHeader($htmlCabecalho);
$p->SetHTMLFooter($htmlRodape);
$p->setAutoTopMargin = false;
$p->setAutoBottomMargin = false;
