<script>
    (function () {
        // Mapa simples pra rotular o tipo do anexo de forma humana.
        var rotuloTipo = {
            'EXAME': 'Exame',
            'LAUDO_EXAME': 'Laudo',
            'AVALIACAO': 'Avaliação',
            'CERTIFICADO': 'Certificado'
        };

        $('#modal-ultimo-exame').on('show.bs.modal', function (event) {
            var trigger = $(event.relatedTarget);
            var raw = trigger.attr('data-payload') || '{}';
            var payload;
            try { payload = JSON.parse(raw); } catch (e) { payload = {}; }

            $('#modal-exame-colaborador').text(payload.colaborador || '—');
            $('#modal-exame-data').text(payload.data_exame || '—');
            $('#modal-exame-tipo').text(payload.tipo || '—');

            var $lista = $('#modal-exame-anexos').empty();
            var anexos = payload.anexos || [];
            if (anexos.length === 0) {
                $lista.append('<li class="list-group-item text-muted">Nenhum arquivo anexado.</li>');
                return;
            }
            anexos.forEach(function (anexo) {
                // Padrão "<Tipo> - <Colaborador> - <Data>" (ex.: "Exame - WESLEY LUCAS LELIS DE AGUIAR - 30/01/2017").
                // Vale só pro rótulo no list-group; o nome do arquivo real do download vem do
                // Content-Disposition do presigned (Laravel monta de arquivo_upload_descricao).
                var partes = [
                    rotuloTipo[anexo.tipo] || (anexo.tipo ? anexo.tipo : 'Arquivo'),
                    payload.colaborador || '',
                    payload.data_exame || ''
                ].filter(function (s) { return s && String(s).trim() !== ''; });
                var rotulo = partes.join(' - ');
                var href = '/arquivo-upload/descarregar/id/' + encodeURIComponent(anexo.id);

                // Abrir em nova aba via window.open (mais confiável que target="_blank" em <a>,
                // que ocasionalmente é ignorado pelo navegador em redirects 302). O href fica
                // mantido pra preservar UX de right-click → "Abrir em nova guia"/"Copiar link".
                var abrirNovaAba = function (e) {
                    if (e) e.preventDefault();
                    window.open(href, '_blank', 'noopener,noreferrer');
                };

                var $item = $('<li class="list-group-item"></li>');
                var $icone = $('<i class="fa fa-file-o" style="margin-right: 6px;"></i>');
                var $link = $('<a></a>')
                    .attr('href', href)
                    .attr('target', '_blank')
                    .attr('rel', 'noopener noreferrer')
                    .text(rotulo)
                    .on('click', abrirNovaAba);
                var $btn = $('<a class="btn btn-xs btn-primary pull-right"></a>')
                    .attr('href', href)
                    .attr('target', '_blank')
                    .attr('rel', 'noopener noreferrer')
                    .html('<i class="fa fa-download"></i> Baixar')
                    .on('click', abrirNovaAba);
                $item.append($icone).append($link).append($btn);
                $lista.append($item);
            });
        });
    })();
</script>

